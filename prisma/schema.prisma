generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GeneralStatus {
  ACTIVE
  DEACTIVE
  DELETED
}

model user{
  //unique
  id String @id @default(uuid())
  email String @unique

  //Actual data
  password String
  name String?
  
  //Non unique defaults
  status GeneralStatus @default(ACTIVE)

  //dates 
  created_at DateTime @default(now())
  updated_at DateTime? 
  deleted_at DateTime?
}

model permission{
  //Unique
  id Int @id @default(autoincrement()) @map("id")
  name String @unique
  module String @unique
  uri String @unique
  permission String @unique

  //actual data
  description String?

  //Non unique defaults
  status GeneralStatus @default(ACTIVE)

  //dates 
  created_at DateTime @default(now())
  updated_at DateTime? 
  deleted_at DateTime

  //relations
  permissions group_permissions[]
}

model groups {
  //Unque
  id String @id @default(cuid())
  name String @unique

  //actual data
  description String?

  //Non unique defaults
  status GeneralStatus @default(ACTIVE)

  //dates 
  created_at DateTime @default(now())
  updated_at DateTime? 
  deleted_at DateTime

  //relations
  permissions group_permissions[]
} 


//Relationnship Models
model group_permissions {
  group_id String
  group_rep groups @relation(fields: [group_id], references: [id])

  permission_id Int
  permission_rel permission @relation(fields: [permission_id], references: [id]) 
  @@id([group_id, permission_id])
}