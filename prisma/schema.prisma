// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GeneralStatus {
  ACTIVE
  DEACTIVE
  DELETED
}

model user{
  //unique
  id String @id @default(uuid())
  email String @unique

  //Actual data
  password String
  name String?
  
  //Non unique defaults
  status GeneralStatus @default(ACTIVE)

  //dates 
  created_at DateTime @default(now())
  updated_at DateTime? 
  deleted_at DateTime?

  //relationships
  user_rel user_groups[]
}

model permission{
  //Unique
  id Int @id @default(autoincrement()) @map("id")
  name String @unique
  module String @unique
  uri String @unique
  permission String @unique

  //actual data
  description String?

  //Non unique defaults
  status GeneralStatus @default(ACTIVE)

  //dates 
  created_at DateTime @default(now())
  updated_at DateTime? 
  deleted_at DateTime

  //relations
  permissions group_permissions[]
}

model groups {
  //Unique
  id String @id @default(cuid())
  name String @unique

  //actual data
  description String?

  //Non unique defaults
  status GeneralStatus @default(ACTIVE)

  //dates 
  created_at DateTime @default(now())
  updated_at DateTime? 
  deleted_at DateTime

  //relations
  permissions group_permissions[]
  group_rel user_groups[]
} 

enum StoreKind {
  TERABYTE
  PICHAU
  KABUM
  ALIEXPRESS
  OTHER //never happen
}

model Product {
  //Unique 
  id          String  @id @default(uuid())
  slug String @unique //Core key to the product (url friendly)

  //Non Unique defaults
  store       StoreKind @default(OTHER)
  status GeneralStatus @default(ACTIVE)
  
  //Actual data
  title       String?
  description String?
  value       Float
  link        String
  where       String
  imageUrl    String?

  //dates 
  created_at DateTime @default(now())
  updated_at DateTime? 
  deleted_at DateTime?

  //Relations
  priceHistory Price[]
}

//Price History Model (of an specific product price in a specific date)
model Price {
  //Unique
  id String @id @default(uuid())

  //Actual data
  atDate DateTime
  price  Float

  //Relations
  prodRef Product @relation(fields: [prodId], references: [id])
  prodId  String
}

//Relationnship Models
model group_permissions {
  group_id String
  group_rep groups @relation(fields: [group_id], references: [id])

  permission_id Int
  permission_rel permission @relation(fields: [permission_id], references: [id]) 
  @@id([group_id, permission_id])
}

model user_groups{
    group_id String
    group_rel groups @relation(fields: [group_id], references: [id])
    
    user_id String
    user_rel user @relation(fields: [user_id], references: [id]) 
    @@id([group_id, user_id])
}